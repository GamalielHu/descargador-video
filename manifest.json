{
  "manifest_version": 3,
  "name": "Descargador de Video",
  "version": "1.5.0",
  "description": "Detecta y descarga videos y streams HLS sin cifrar de la página actual.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "downloads", "webRequest", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Descargador de Video" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["mse-flag.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
